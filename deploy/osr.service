[Unit]
Description=Open Shots Repository
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=osr
Group=osr
EnvironmentFile=/etc/osr/server.env
ExecStart=/opt/osr/bin/osr-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
